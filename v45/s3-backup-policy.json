{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::novatrix-backup-01oscand-01",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "backup/",
            "backup/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteDatabaseBackupsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::novatrix-backup-01oscand-01/backup/*"
    }
  ]
}
