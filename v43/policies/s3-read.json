{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSelectedBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::novatrix-data-01oscand-v43"
    },
    {
      "Sid": "ReadObjectsInSelectedBucket",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::novatrix-data-01oscand-v43/*"
    }
  ]
}
